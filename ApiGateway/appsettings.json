{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth_prefix_route": {
        "ClusterId": "auth_cluster",
        "Match": { "Path": "/auth/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/auth" }]
      },
      "auth_api_route": {
        "ClusterId": "auth_cluster",
        "Order": 1,
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "auth_swagger_route": {
        "ClusterId": "auth_cluster",
        "Order": 1,
        "Match": { "Path": "/swagger/{**catch-all}" }
      },
      "lostfound_route": {
        "ClusterId": "lostfound_cluster",
        "Match": { "Path": "/lostfound/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/lostfound" }]
      },
      "club_route": {
        "ClusterId": "club_cluster",
        "Match": { "Path": "/club/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/club" }]
      }
    },
    "Clusters": {
      "auth_cluster": {
        "Destinations": { "d1": { "Address": "http://authservice:8080" } }
      },
      "lostfound_cluster": {
        "Destinations": { "d1": { "Address": "http://lostfoundservice:8080" } }
      },
      "club_cluster": {
        "Destinations": { "d1": { "Address": "http://clubmanagementservice:8080" } }
      }
    }
  }
}
