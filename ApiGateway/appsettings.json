{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ],
    "AllowCredentials": false
  },

  "ReverseProxy": {
    "Routes": {

      "auth_api": {
        "ClusterId": "auth_cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },

      "auth_proxy": {
        "ClusterId": "auth_cluster",
        "Match": { "Path": "/auth/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/auth" }
        ]
      },

      "lostfound_api": {
        "ClusterId": "lostfound_cluster",
        "Match": { "Path": "/lostfound/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/lostfound" }
        ]
      },

      "club_api": {
        "ClusterId": "club_cluster",
        "Match": { "Path": "/club/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/club" }
        ]
      },

      "location_api": {
        "ClusterId": "location_cluster",
        "Match": { "Path": "/location/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/location" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/location" }
        ]
      },

      "notification_api": {
        "ClusterId": "notification_cluster",
        "Match": { "Path": "/notification/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/notification" }
        ]
      },

      "call_api": {
        "ClusterId": "call_cluster",
        "Match": { "Path": "/call/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/call" }
        ]
      },

      "support_api": {
        "ClusterId": "support_cluster",
        "Match": { "Path": "/support/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/support" }
        ]
      },

      "orders_api": {
        "ClusterId": "orders_cluster",
        "Match": { "Path": "/orders/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/orders" }
        ]
      },

      "attendance_api": {
        "ClusterId": "attendance_cluster",
        "Match": { "Path": "/attendance/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/attendance" }
        ]
      }

    },

    "Clusters": {

      "auth_cluster": {
        "Destinations": {
          "d1": { "Address": "http://authservice:8080/" }
        }
      },

      "lostfound_cluster": {
        "Destinations": {
          "d1": { "Address": "http://lostfoundservice:8080/" }
        }
      },

      "club_cluster": {
        "Destinations": {
          "d1": { "Address": "http://clubmanagementservice:8080/" }
        }
      },

      "location_cluster": {
        "Destinations": {
          "d1": { "Address": "http://locationservice:8080/" }
        }
      },

      "notification_cluster": {
        "Destinations": {
          "d1": { "Address": "http://notificationservice:8080/" }
        }
      },

      "call_cluster": {
        "Destinations": {
          "d1": { "Address": "http://callservice:8080/" }
        }
      },

      "support_cluster": {
        "Destinations": {
          "d1": { "Address": "http://myadasupportservice:8080/" }
        }
      },

      "orders_cluster": {
        "Destinations": {
          "d1": { "Address": "http://orders-service:8080/" }
        }
      },

      "attendance_cluster": {
        "Destinations": {
          "d1": { "Address": "http://myadaattandanceservice:8080/" }
        }
      }

    }
  }
}
