{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth_route": {
        "ClusterId": "auth_cluster",
        "Match": { "Path": "/auth/{**catch-all}" }
      },
      "lostfound_route": {
        "ClusterId": "lostfound_cluster",
        "Match": { "Path": "/lostfound/{**catch-all}" }
      },
      "club_route": {
        "ClusterId": "club_cluster",
        "Match": { "Path": "/club/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth_cluster": {
        "Destinations": { "d1": { "Address": "http://authservice:8080/" } }
      },
      "lostfound_cluster": {
        "Destinations": { "d1": { "Address": "http://lostfoundservice:8080/" } }
      },
      "club_cluster": {
        "Destinations": { "d1": { "Address": "http://clubmanagementservice:8080/" } }
      }
    }
  }
}