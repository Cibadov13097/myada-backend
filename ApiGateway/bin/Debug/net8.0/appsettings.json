{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {

      // ---------- AUTH SERVICE ----------

      "auth_api": {
        "ClusterId": "auth_cluster",
        "Order": 0,
        "Match": { "Path": "/auth/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/auth" }
        ]
      },

      "auth_swagger": {
        "ClusterId": "auth_cluster",
        "Order": 1,
        "Match": { "Path": "/auth/swagger/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/auth" }
        ]
      },


      // ---------- LOST FOUND SERVICE (deaktiv) ----------
      // "lostfound_api": { ... },
      // "lostfound_swagger": { ... },


      // ---------- CLUB SERVICE ----------

      "club_api": {
        "ClusterId": "club_cluster",
        "Order": 0,
        "Match": { "Path": "/club/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/club" }
        ]
      },

      "club_swagger": {
        "ClusterId": "club_cluster",
        "Order": 1,
        "Match": { "Path": "/club/swagger/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/club" }
        ]
      }
    },

    "Clusters": {

      "auth_cluster": {
        "Destinations": {
          "d1": { "Address": "http://authservice:8080/" }
        }
      },

      "club_cluster": {
        "Destinations": {
          "d1": { "Address": "http://clubmanagementservice:8080/" }
        }
      }

    }
  }
}