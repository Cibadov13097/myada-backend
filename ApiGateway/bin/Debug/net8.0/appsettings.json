{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {

      "auth_route": {
        "ClusterId": "auth_cluster",
        "Match": { "Path": "/auth/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/auth" }
        ]
      },

      "lostfound_route": {
        "ClusterId": "lostfound_cluster",
        "Match": { "Path": "/lostfound/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/lostfound" }
        ]
      },

      "club_route": {
        "ClusterId": "club_cluster",
        "Match": { "Path": "/club/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/club" }
        ]
      }

    },

    "Clusters": {

      "auth_cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5019/" }
        }
      },

      "lostfound_cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5096/" }
        }
      },

      "club_cluster": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5138/" }
        }
      }

    }
  }
}