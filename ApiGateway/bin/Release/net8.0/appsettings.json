{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {

      "auth_api": {
        "ClusterId": "auth_cluster",
        "Match": { "Path": "/api-gateway/auth/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api-gateway/auth" }
        ]
      },

      "lostfound_api": {
        "ClusterId": "lostfound_cluster",
        "Match": { "Path": "/api-gateway/lostfound/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api-gateway/lostfound" }
        ]
      },

      "club_api": {
        "ClusterId": "club_cluster",
        "Match": { "Path": "/api-gateway/club/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api-gateway/club" }
        ]
      },

      "location_api": {
        "ClusterId": "location_cluster",
        "Match": { "Path": "/api-gateway/location/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api-gateway/location" }
        ]
      },

      "notification_api": {
        "ClusterId": "notification_cluster",
        "Match": { "Path": "/api-gateway/notification/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api-gateway/notification" }
        ]
      },

      "call_api": {
        "ClusterId": "call_cluster",
        "Match": { "Path": "/api-gateway/call/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api-gateway/call" }
        ]
      }
    },

    "Clusters": {

      "auth_cluster": {
        "Destinations": {
          "d1": { "Address": "http://authservice:8080/" }
        }
      },

      "lostfound_cluster": {
        "Destinations": {
          "d1": { "Address": "http://lostfoundservice:8080/" }
        }
      },

      "club_cluster": {
        "Destinations": {
          "d1": { "Address": "http://clubmanagementservice:8080/" }
        }
      },

      "location_cluster": {
        "Destinations": {
          "d1": { "Address": "http://locationservice:8080/" }
        }
      },

      "notification_cluster": {
        "Destinations": {
          "d1": { "Address": "http://notificationservice:8080/" }
        }
      },

      "call_cluster": {
        "Destinations": {
          "d1": { "Address": "http://callservice:8080/" }
        }
      }
    }
  }
}
