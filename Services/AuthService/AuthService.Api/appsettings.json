{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Develop": "Host=myada;Port=5432;Database=AuthDb;Username=postgres;Password=123"
  },
  "Jwt": {
    "Issuer": "myada-auth",
    "KeyId": "my-key-id-1",
    "Audience": "myada-api",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 30,
    "PrivateKeyPath": "/keys/private.pem",
    "PublicKeyPath": "/keys/public.pem"
  },
  "SupportService": {
    "BaseUrl": "http://myadasupportservice:8080",
    "ProvisioningPath": "/api/SupportStaffStatuses/internal/provision",
    "ProvisioningKey": "myada-internal-key"
  },
  "NotificationService": {
    "BaseUrl": "http://notificationservice:8080",
    "SendEmailPath": "/api/v1/notifications/email",
    "RequestTimeoutSeconds": 10
  },
  "PasswordReset": {
    "ClientResetUrl": "http://localhost:3000/reset-password"
  },
  "S3": {
    "BucketName": "myada-app",
    "Region": "us-east-1",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin123",
    "ServiceUrl": "http://host.docker.internal:9000",
    "ForcePathStyle": true,
    "PublicBaseUrl": "http://localhost:9000/myada-app",
    "KeyPrefix": "users",
    "AutoCreateBucket": true
  },
 
    "Redis": {
      "ConnectionString": "myada-redis:6379,abortConnect=false"
    }
  
}
