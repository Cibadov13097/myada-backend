# Local MinIO (http://localhost:9000 / console :9001)
# Docker services reach MinIO via host.docker.internal; browsers use localhost.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

LOSTFOUND_S3_BUCKET_NAME=myada-app
LOSTFOUND_S3_REGION=us-east-1
LOSTFOUND_S3_ACCESS_KEY=minioadmin
LOSTFOUND_S3_SECRET_KEY=minioadmin123
LOSTFOUND_S3_SERVICE_URL=http://host.docker.internal:9000
LOSTFOUND_S3_FORCE_PATH_STYLE=true
LOSTFOUND_S3_PUBLIC_BASE_URL=http://localhost:9000/myada-app
LOSTFOUND_S3_AUTO_CREATE_BUCKET=true
LOSTFOUND_S3_KEY_PREFIX=lost-and-found

CLUB_S3_BUCKET_NAME=myada-app
CLUB_S3_REGION=us-east-1
CLUB_S3_ACCESS_KEY=minioadmin
CLUB_S3_SECRET_KEY=minioadmin123
CLUB_S3_SERVICE_URL=http://host.docker.internal:9000
CLUB_S3_FORCE_PATH_STYLE=true
CLUB_S3_PUBLIC_BASE_URL=http://localhost:9000/myada-app
CLUB_S3_AUTO_CREATE_BUCKET=true
CLUB_S3_KEY_PREFIX=clubs

SUPPORT_S3_BUCKET_NAME=myada-app
SUPPORT_S3_REGION=us-east-1
SUPPORT_S3_ACCESS_KEY=minioadmin
SUPPORT_S3_SECRET_KEY=minioadmin123
SUPPORT_S3_SERVICE_URL=http://host.docker.internal:9000
SUPPORT_S3_FORCE_PATH_STYLE=true
SUPPORT_S3_PUBLIC_BASE_URL=http://localhost:9000/myada-app
SUPPORT_S3_AUTO_CREATE_BUCKET=true
SUPPORT_S3_KEY_PREFIX=support

AUTH_S3_KEY_PREFIX=users
AUTH_S3_AUTO_CREATE_BUCKET=true

NOTIFICATION_SMTP_HOST=smtp.gmail.com
